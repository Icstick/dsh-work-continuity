{
  "name": "dsh-work-continuity",
  "description": "Work Continuity for DSH — goal/decisions/checkpoints/next-steps as explicit WorkState, decoupled from generic memory",
  "version": "0.4.0",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": {
      "default": "./src/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-alpha.0 <1.0.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-alpha.0 <1.0.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/schemastery": ">=3.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@deepseek-ai/schemastery": ">=3.0.0",
    "@types/node": "^26.0.0",
    "oxlint": "^0.18.1"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "lint": "oxlint",
    "build:client": "node scripts/build-client.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Icstick/dsh-work-continuity.git"
  },
  "homepage": "https://github.com/Icstick/dsh-work-continuity",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis"
  ]
}
